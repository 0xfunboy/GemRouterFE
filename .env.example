# =============================================================================
# GemRouter local deployment
# =============================================================================

# Server bind address and public service port.
HOST=0.0.0.0
PORT=4024

# Repository and writable runtime data paths.
GEMROUTER_ROOT_DIR=/absolute/path/to/GemRouter
GEMROUTER_DATA_DIR=data

# Public URL used by the admin UI and compatibility metadata.
GEMROUTER_PUBLIC_BASE_URL=https://gemr.example.com

# =============================================================================
# Dashboard and compatibility surfaces
# =============================================================================

# Enable the operator admin UI.
GEMROUTER_DASHBOARD_ENABLED=true
GEMROUTER_ADMIN_SESSION_TTL_MS=86400000

# Dashboard users in username:password format.
GEMROUTER_DASHBOARD_ADMIN_USERS=admin:replace-me

# Default compatibility surface shown to clients.
GEMROUTER_COMPAT_DEFAULT_SURFACE=gemrouter
GEMROUTER_COMPAT_ENABLED_SURFACES=gemrouter,openai,deepseek,ollama

# =============================================================================
# Local router auth and client policy
# =============================================================================

# Admin bearer token for privileged API calls.
GEMROUTER_ADMIN_TOKEN=replace-me

# Bootstrap app key used by local clients.
GEMROUTER_BOOTSTRAP_API_KEY=replace-me
GEMROUTER_BOOTSTRAP_APP_NAME=local-client
GEMROUTER_BOOTSTRAP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*
GEMROUTER_BOOTSTRAP_ALLOWED_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemma-4-31b-it
GEMROUTER_BOOTSTRAP_SESSION_NAMESPACE=local-client
GEMROUTER_BOOTSTRAP_RATE_LIMIT_PER_MINUTE=30
GEMROUTER_BOOTSTRAP_MAX_CONCURRENCY=2

# =============================================================================
# Backend routing
# =============================================================================

# Normal flow: official Gemini API first; Ollama can be appended when an inventory exists.
# Add "nvidia" to route vendor-prefixed models (deepseek-ai/*, moonshotai/*, ...) to NVIDIA NIM.
GEMROUTER_BACKEND_ORDER=gemini-api,nvidia

# =============================================================================
# Gemini real-quota sync via Google Cloud Monitoring
# =============================================================================

# Reads REAL per-project quota usage every 30 min (or on demand via
# POST /v1/admin/quota-monitor/refresh) and realigns the local RPD ledger.
# Requires a service account with roles/monitoring.viewer in each Gemini project;
# see docs/gemini-quota-monitor.md for the setup commands.
GEMROUTER_GEMINI_QUOTA_MONITOR_ENABLED=true
GEMROUTER_GEMINI_QUOTA_MONITOR_CREDENTIALS_PATH=data/gcp-monitoring-credentials.json
GEMROUTER_GEMINI_QUOTA_MONITOR_REFRESH_MS=1800000

# =============================================================================
# NVIDIA NIM backend (integrate.api.nvidia.com, OpenAI-compatible)
# =============================================================================

# API key from build.nvidia.com. Backend auto-enables when the key is present.
GEMROUTER_NVIDIA_ENABLED=true
GEMROUTER_NVIDIA_API_KEY=
GEMROUTER_NVIDIA_BASE_URL=https://integrate.api.nvidia.com

# Curated catalog (id/tier/enabled/probe/aliases) and per-hour score persistence.
GEMROUTER_NVIDIA_MODELS_PATH=data/nvidia-models.json
GEMROUTER_NVIDIA_SCOREBOARD_PATH=data/nvidia-scoreboard.json

# Tier used for "nvidia-auto" requests: small | medium | large.
GEMROUTER_NVIDIA_DEFAULT_TIER=large

# Local budget for the key (NVIDIA free tier is ~40 RPM).
GEMROUTER_NVIDIA_RPM_LIMIT=36
GEMROUTER_NVIDIA_MAX_CONCURRENCY=8

# Stall detection and timeouts.
GEMROUTER_NVIDIA_FIRST_TOKEN_TIMEOUT_MS=25000
GEMROUTER_NVIDIA_TIMEOUT_MS=120000

# Hedged race for tier/alias requests (nvidia-auto, nvidia-large, ...).
GEMROUTER_NVIDIA_RACE_ENABLED=true
GEMROUTER_NVIDIA_RACE_HEDGE_DELAY_MS=8000
GEMROUTER_NVIDIA_RACE_MAX_CANDIDATES=3

# Hourly latency probe to learn the time-of-day profile per model.
GEMROUTER_NVIDIA_PROBE_ENABLED=true
GEMROUTER_NVIDIA_PROBE_INTERVAL_MS=3600000
GEMROUTER_NVIDIA_PROBE_MAX_TOKENS=16

# =============================================================================
# Official Gemini API backend
# =============================================================================

# AI Studio / Gemini Developer API key path. Do not commit real keys.
GEMROUTER_GEMINI_API_ENABLED=false
GEMROUTER_GEMINI_API_KEYS=
GEMROUTER_GEMINI_API_ACCOUNTS_PATH=data/gemini-api-accounts.json

# Gemini API endpoint and discovery version.
GEMROUTER_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMROUTER_GEMINI_API_VERSION=v1beta

# Compatibility-safe public model list for the current HTTP router.
GEMROUTER_DIRECT_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemma-4-31b-it
GEMROUTER_FREE_TIER_TEXT_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemma-4-31b-it
GEMROUTER_FREE_TIER_AUDIO_MODELS=gemini-3.1-flash-live-preview,gemini-3.1-flash-tts-preview,gemini-2.5-flash-native-audio-preview-12-2025,gemini-2.5-flash-preview-tts
GEMROUTER_FREE_TIER_EMBEDDING_MODELS=gemini-embedding-2
GEMROUTER_TEXT_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemma-4-31b-it
GEMROUTER_FREE_TIER_POLICY_ENABLED=true
GEMROUTER_FREE_TIER_REFRESH_MS=86400000
GEMROUTER_INCLUDE_THOUGHTS=false
GEMROUTER_STRIP_REASONING=true
GEMROUTER_THINKING_LEVEL=minimal
GEMROUTER_THINKING_BUDGET=0

# Quota model. per-key assumes every key has an independent Google project/account.
GEMROUTER_GEMINI_API_DEFAULT_TIER=tier1
GEMROUTER_GEMINI_API_DEFAULT_QUOTA_GROUP_MODE=per-key
GEMROUTER_GEMINI_API_LIMITS_JSON=
GEMROUTER_GEMINI_API_LIMITS_PATH=

# Local quota ledger and model discovery cache.
GEMROUTER_GEMINI_API_LEDGER_PATH=data/gemini-api-quota-ledger.json
GEMROUTER_GEMINI_API_DISCOVERY_CACHE_PATH=data/gemini-api-models-cache.json
GEMROUTER_GEMINI_API_DISCOVERY_REFRESH_MS=21600000

# RPM/TPM/RPD windows and cooldown behavior.
GEMROUTER_GEMINI_API_QUOTA_COOLDOWN_MS=600000
GEMROUTER_GEMINI_API_RPD_WINDOW_MS=86400000
GEMROUTER_GEMINI_API_RPM_WINDOW_MS=60000
GEMROUTER_GEMINI_API_TPM_WINDOW_MS=60000
GEMROUTER_GEMINI_API_COUNT_TOKENS_PREFLIGHT=false
GEMROUTER_GEMINI_API_COUNT_FAILED_429_AS_USAGE=false

# Network timeouts.
GEMROUTER_GEMINI_API_TIMEOUT_MS=120000
GEMROUTER_GEMINI_API_STREAM_TIMEOUT_MS=180000

# =============================================================================
# Optional Ollama backend
# =============================================================================

# Inventory generated out-of-band with Ollama endpoints and models. If present,
# GemRouter appends ollama to the backend order while keeping Gemini first.
GEMROUTER_OLLAMA_ENABLED=false
GEMROUTER_OLLAMA_INVENTORY_PATH=ollama-model-inventory.json
GEMROUTER_OLLAMA_MODELS=
GEMROUTER_OLLAMA_EXCLUDE_CLOUD_MODELS=true
GEMROUTER_OLLAMA_MIN_PARAMETER_SCORE=0
GEMROUTER_OLLAMA_TIMEOUT_MS=120000
GEMROUTER_OLLAMA_STREAM_TIMEOUT_MS=180000
