[Unit]
Description=Cloudflare Tunnel for solclawn
Wants=network-online.target leakrouter.service
After=network-online.target leakrouter.service

[Service]
Type=simple
WorkingDirectory=/home/OPERATOR
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/bin/cloudflared tunnel --config /home/OPERATOR/.cloudflared/solclawn.yml run 00000000-0000-0000-0000-66cc3c64c659
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
