[Unit]
Description=Cloudflare Tunnel for gemrouter
Wants=network-online.target gemrouter.service
After=network-online.target gemrouter.service

[Service]
Type=simple
User=funboy
WorkingDirectory=/home/OPERATOR
Environment=HOME=/home/OPERATOR
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/bin/cloudflared tunnel --config /home/OPERATOR/GemRouter/ops/cloudflared/gemrouter.yml run 00000000-0000-0000-0000-ea15107c6537
Restart=always
RestartSec=5
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
