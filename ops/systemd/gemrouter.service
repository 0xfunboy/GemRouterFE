[Unit]
Description=GemRouter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=funboy
WorkingDirectory=/home/OPERATOR/INFRA/gem-router
EnvironmentFile=/home/OPERATOR/INFRA/gem-router/.env
Environment=HOME=/home/OPERATOR
Environment=NODE_ENV=production
Environment=PNPM_HOME=/home/OPERATOR/.local/share/pnpm
Environment=NVM_DIR=/home/OPERATOR/.nvm
Environment=PATH=/home/OPERATOR/.nvm/versions/node/v24.18.0/bin:/home/OPERATOR/.local/share/pnpm:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/bin/bash -lc "pnpm build"
ExecStart=/bin/bash -lc "exec node dist/index.js"
Restart=always
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
